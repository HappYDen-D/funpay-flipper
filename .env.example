# ==============================================================================
# FunPay Flipper — Environment Configuration Template
# Copy this file to .env and fill in your values. DO NOT commit real secrets!
# ==============================================================================

# --- Telegram Bot Configuration ---
# Dedicated Telegram Bot token from @BotFather (REQUIRED)
FLIPPER_BOT_TOKEN=your_bot_token_here

# Comma-separated numeric Telegram user IDs of authorized bot administrators (REQUIRED)
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=0

# Dedicated proxy for Telegram Bot API if Telegram is blocked or restricted (optional)
# Supports: http://, https://, socks5://, socks5h://
# TELEGRAM_PROXY=socks5://127.0.0.1:10808
# TELEGRAM_API_SERVER=https://api.telegram.org

# --- FunPay Account & Transport ---
# FunPay golden_key session cookie from your browser storage (funpay.com)
FUNPAY_GOLDEN_KEY=your_golden_key_cookie_here

# Dedicated proxy for all FunPay HTTP requests (optional)
# FunPay client strictly uses this proxy and never leaks ambient environment proxies
# FUNPAY_PROXY=http://user:password@proxy_host:proxy_port
AUTO_DETECT_PROXY=false

# --- Database & Storage ---
# Path to SQLite database file (defaults to ./auto_flipper.db)
FLIPPER_DB_PATH=auto_flipper.db

# --- Arbitrage Financial Controls & Safety Limits ---
# DRY RUN mode: simulation only, real payments are blocked (recommended: true)
FLIPPER_DRY_RUN=true

# Auto-buy toggle: false enforces ASSIST mode with manual approval
FLIPPER_AUTO_BUY=false

# Seller quality thresholds (filters out unreputable sellers)
FLIPPER_MIN_SELLER_RATING=4.8
FLIPPER_MIN_SELLER_REVIEWS=5
DEFAULT_PROFIT_GOAL=5000.0

# --- Legacy / Fallback Limits ---
# NOTE: In the v0.1.x ASSIST pilot, trade sizing and risk limits are managed
# dynamically via the capital ledger (capital_store.py), confirmed balance
# proofs (/cash), and PILOT_POLICY risk gate (resale_intelligence/models/risk_gate.py:
# 40% reserve, 25% lot cap, 40% category cap, 10% loss stop). Trade admission and
# exit hurdles are enforced by exit_policy.py (min 10 RUB profit, 15% ROI).
# The parameters below are retained solely as legacy defaults / fallback overrides:
FLIPPER_MAX_BUDGET=350.0
FLIPPER_MIN_PROFIT=150.0
FLIPPER_MIN_MARGIN_PCT=35.0
